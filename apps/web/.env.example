# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time; the rest
# are read by the server at run time. The packaged app reads run-time values
# from ~/.perkos-xyz/env in this same format.

# Wallet sign in. With the Dynamic environment id set (public, not a secret,
# the same dashboard the rest of PerkOS uses) the window opens Dynamic's
# connector; without it the app falls back to the previous one. Set
# NEXT_PUBLIC_WALLET_CONNECTOR=legacy to force the previous one anyway.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# NEXT_PUBLIC_WALLET_CONNECTOR=legacy

# Privy app id (public, not a secret). Used when the id above is empty.
NEXT_PUBLIC_PRIVY_APP_ID=
# WalletConnect Cloud project id (public). Required for external wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Force the WalletConnect path even where an injected wallet exists (debug).
# NEXT_PUBLIC_WALLETCONNECT_FORCE=1

# Base JSON-RPC. Default: the public node. A private endpoint is faster.
# BASE_RPC_URL=https://base-rpc.publicnode.com

# Bankr second quote (Wallet API, read-only key). Optional: without it the
# desk quotes with Uniswap only.
BANKR_API_KEY=

# PerkOS session (same account as the PerkOS app). Public URLs, defaults = production.
# PERKOS_API_URL=https://api.perkos.xyz
# PERKOS_OAUTH_URL=https://oauth.perkos.xyz
# Desk template id to deploy (default floor-desk).
# PERKOS_FLEET_TEMPLATE=floor-desk

# PerkOS Knowledge, public tier (no key). Every desk turn reads it.
# KNOWLEDGE_BASE_URL=https://knowledge.perkos.xyz
# KNOWLEDGE_TIMEOUT_MS=1500
# KNOWLEDGE_DESK_TIMEOUT_MS=3000
# Publishing desk knowledge: only the install that holds the token. The
# contributor agent must exist in Knowledge. See scripts/publish-desk-knowledge.mjs.
# KNOWLEDGE_INGEST_TOKEN=
# KNOWLEDGE_AGENT_ID=perkos-floor-desk

# xAI (Grok): OAuth by device flow, no key here. Override the API base if needed.
# XAI_BASE_URL=https://api.x.ai/v1

# Local paths (defaults under ~/.perkos-xyz and the bundled knowledge folder).
# PERKOS_KB_DIR=
# PERKOS_BUNDLED_KB=
# PERKOS_BRIEF_PATH=./knowledge/perkos.md
