# Public Privy app id (same as PerkOS App). Not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect Cloud project id. Publico, no es un secreto.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# PerkOS Knowledge (contexto vivo del chat). Tier publico: sin key ni wallet.
# KNOWLEDGE_BASE_URL=https://knowledge.perkos.xyz
# KNOWLEDGE_TIMEOUT_MS=1500
# Publicacion de conocimiento de la mesa en PerkOS Knowledge (solo la instalacion
# editora; las demas leen el tier publico sin llave). El agente contribuidor
# debe existir en Knowledge. Ver scripts/publish-desk-knowledge.mjs.
# KNOWLEDGE_INGEST_TOKEN=
# KNOWLEDGE_AGENT_ID=perkos-floor-desk
# KNOWLEDGE_DESK_TIMEOUT_MS=3000
# PERKOS_BRIEF_PATH=./knowledge/perkos.md

# Sesion PerkOS (misma cuenta que PerkOS App): nonce de api.perkos.xyz firmado
# por la wallet del usuario -> PerkOS-OAuth (oauth.perkos.xyz) emite el token.
# Sin keys en el cliente: solo URLs publicas. Defaults = produccion.
# PERKOS_API_URL=https://api.perkos.xyz
# PERKOS_OAUTH_URL=https://oauth.perkos.xyz

# Bankr second quote (Wallet API + Read Only key on an empty account). Optional.
BANKR_API_KEY=
