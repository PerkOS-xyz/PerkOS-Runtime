{
  "name": "perkos-runtime",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm start -w @perkos/runtime-desktop",
    "dev": "npm run dev -w @perkos/runtime-web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run build -w @perkos/ens",
    "pretypecheck": "npm run build -w @perkos/ens",
    "predev": "npm run build -w @perkos/ens",
    "prestart": "npm run build -w @perkos/ens"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
